<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create User</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="w-full h-full bg-zinc-900 p-10 text-white">

        <div class="nav mb-10">
            <a class="text-blue-500" href="/read">Read Users</a>
        </div>

        <h1 class="text-3xl tracking-tighter mb-3">
            Create User
        </h1>

        <form action="/create" method="POST">

            <input
                class="px-5 py-3 border-2 border-zinc-800 text-black"
                type="text"
                name="name"
                placeholder="name"
                required
            >

            <input
                class="px-5 py-3 border-2 border-zinc-800 text-black"
                type="email"
                name="email"
                placeholder="email"
                required
            >

            <input
                class="px-5 py-3 border-2 border-zinc-800 text-black"
                type="text"
                name="imageurl"
                placeholder="image url"
                required
            >

            <input
                class="px-5 py-3 bg-blue-500 rounded-md"
                type="submit"
                value="Create User"
            >

        </form>

    </div>

</body>

</html>